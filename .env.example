# ─── Django core ───────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Database ──────────────────────────────────────────────────
# Leave blank for local SQLite. On Render, paste the Internal
# Database URL from your Render Postgres instance.
DATABASE_URL=

# ─── Email ─────────────────────────────────────────────────────
# Console backend in dev (emails print to terminal).
# On Render, switch to SMTP or an API like SendGrid / Resend.
CONTACT_RECIPIENT=hello@glowandgrace.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@glowandgrace.com